{
  "$defs": {
    "InputType": {
      "description": "Shape of the raw material an Idea originated from.",
      "enum": [
        "observation",
        "overheard",
        "quote",
        "question",
        "pattern_note",
        "research_snippet",
        "personal_experience",
        "reader_reaction",
        "other"
      ],
      "title": "InputType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "raw_input_id": {
      "title": "Raw Input Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "text": {
      "description": "Verbatim material exactly as it was received. Never edited in place.",
      "title": "Text",
      "type": "string"
    },
    "input_type": {
      "$ref": "#/$defs/InputType"
    },
    "origin_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Freeform note on who/where this came from, e.g. 'Janne, observation from meeting'.",
      "title": "Origin Note"
    },
    "language": {
      "description": "ISO 639-1 code, e.g. 'sv', 'en'.",
      "title": "Language",
      "type": "string"
    },
    "content_hash": {
      "default": "",
      "description": "sha256 of `text`, computed at construction. Used only to let tests detect accidental mutation; carries no editorial meaning.",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "raw_input_id",
    "captured_at",
    "text",
    "input_type",
    "language"
  ],
  "title": "RawInput",
  "type": "object"
}
