{
  "$defs": {
    "CtaType": {
      "enum": [
        "none",
        "implicit_reflection",
        "explicit_question",
        "explicit_action",
        "other"
      ],
      "title": "CtaType",
      "type": "string"
    },
    "DegreeLevel": {
      "description": "Generic low/medium/high scale used where Fas 0 material speaks in degrees,\nnot numbers (e.g. personal_presence, solution_degree, contrast_usage).",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "DegreeLevel",
      "type": "string"
    },
    "EmotionalRegister": {
      "enum": [
        "discomfort",
        "recognition",
        "stillness",
        "dignity",
        "relief",
        "urgency",
        "other"
      ],
      "title": "EmotionalRegister",
      "type": "string"
    },
    "EndingType": {
      "enum": [
        "unresolved_scene",
        "resolved_scene",
        "open_question",
        "directive",
        "reflection",
        "other"
      ],
      "title": "EndingType",
      "type": "string"
    },
    "LengthClass": {
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "title": "LengthClass",
      "type": "string"
    },
    "NarrativeMode": {
      "enum": [
        "scene",
        "argument",
        "analysis",
        "letter",
        "list",
        "dialogue",
        "other"
      ],
      "title": "NarrativeMode",
      "type": "string"
    },
    "PointOfView": {
      "enum": [
        "first_person",
        "observer",
        "second_person",
        "collective",
        "other"
      ],
      "title": "PointOfView",
      "type": "string"
    },
    "RhythmPattern": {
      "enum": [
        "uniform",
        "mixed",
        "staccato",
        "flowing"
      ],
      "title": "RhythmPattern",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Compact per-text fingerprint (Beslut 9). Deliberately just a labelled\nsnapshot of ContentForm -- no comparison logic. A future component can\ndiff `VariationFingerprint` instances across the last N publications;\nthis schema only fixes what the labels are and how they are spelled.",
  "properties": {
    "content_id": {
      "description": "FK -> ContentRecord.content_id this fingerprint was taken from.",
      "title": "Content Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "computed_at": {
      "format": "date-time",
      "title": "Computed At",
      "type": "string"
    },
    "form": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrativeMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "opening": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opening"
    },
    "pov": {
      "anyOf": [
        {
          "$ref": "#/$defs/PointOfView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "length": {
      "anyOf": [
        {
          "$ref": "#/$defs/LengthClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rhythm": {
      "anyOf": [
        {
          "$ref": "#/$defs/RhythmPattern"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "emotion": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmotionalRegister"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "personal": {
      "anyOf": [
        {
          "$ref": "#/$defs/DegreeLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "question": {
      "anyOf": [
        {
          "$ref": "#/$defs/DegreeLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contrast": {
      "anyOf": [
        {
          "$ref": "#/$defs/DegreeLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "solution": {
      "anyOf": [
        {
          "$ref": "#/$defs/DegreeLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ending": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndingType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cta": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtaType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "content_id",
    "computed_at"
  ],
  "title": "VariationFingerprint",
  "type": "object"
}
