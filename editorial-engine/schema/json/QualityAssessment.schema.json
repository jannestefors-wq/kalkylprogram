{
  "$defs": {
    "Actor": {
      "description": "Who or what produced a piece of data.",
      "enum": [
        "human",
        "ai_system",
        "import"
      ],
      "title": "Actor",
      "type": "string"
    },
    "EvidenceCertainty": {
      "description": "How solid is a given piece of editorial data.\n\nMirrors Beslut 23's required three-way split, plus an explicit\n\"unconfirmed\" state so that uncertainty is a first-class value rather\nthan an absent field or a disguised default.",
      "enum": [
        "verified",
        "strongly_supported",
        "analytical_proposal",
        "unconfirmed"
      ],
      "title": "EvidenceCertainty",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "actor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free identifier for the actor, e.g. a human's name/initials or an AI system+model name. None only if genuinely unrecorded.",
          "title": "Actor Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "certainty": {
          "$ref": "#/$defs/EvidenceCertainty"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the value was produced, e.g. 'manual_entry', 'fas_0a_analysis', 'fas_0b_analysis', 'ai_inference'.",
          "title": "Method"
        },
        "analysis_logic_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version identifier of whatever analysis logic produced an interpretation, distinct from schema_version. REQUIRED (validated below) whenever created_by == Actor.AI_SYSTEM. May be null for human-created provenance.",
          "title": "Analysis Logic Version"
        },
        "supporting_source_ids": {
          "description": "SOURCE.source_id values that back this claim, if any. Empty list, not a guess, when nothing supports it yet.",
          "items": {
            "type": "string"
          },
          "title": "Supporting Source Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "created_by",
        "created_at",
        "certainty"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityAssessmentResult": {
      "enum": [
        "pass",
        "rework",
        "reangle",
        "hold"
      ],
      "title": "QualityAssessmentResult",
      "type": "string"
    },
    "QualityRuleFinding": {
      "additionalProperties": false,
      "properties": {
        "triggered_rule": {
          "description": "Identifier of the rule that fired, e.g. 'repetition.closing_question.overused'.",
          "title": "Triggered Rule",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "severity": {
          "$ref": "#/$defs/QualitySeverity"
        }
      },
      "required": [
        "triggered_rule",
        "severity"
      ],
      "title": "QualityRuleFinding",
      "type": "object"
    },
    "QualitySeverity": {
      "enum": [
        "minor",
        "moderate",
        "major",
        "blocking"
      ],
      "title": "QualitySeverity",
      "type": "string"
    },
    "ReturnPoint": {
      "description": "Where in the RAW INPUT -> ... -> HUMAN DECISION chain a failed\nQuality Assessment should send the work back to (Beslut 21).",
      "enum": [
        "source",
        "idea",
        "angle",
        "generation",
        "human_review"
      ],
      "title": "ReturnPoint",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "quality_assessment_id": {
      "title": "Quality Assessment Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "content_id": {
      "description": "FK -> ContentRecord.content_id.",
      "title": "Content Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/QualityAssessmentResult"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/QualityRuleFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "recommended_return_point": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReturnPoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where the work should go back to if result != PASS, e.g. REANGLE -> Angle, REWORK -> Generation."
    },
    "voice_core_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FK -> VoiceCoreSnapshot.snapshot_id this assessment checked the content against. V1.1: replaces the earlier free-text label (OQ-1).",
      "title": "Voice Core Snapshot Id"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "quality_assessment_id",
    "content_id",
    "created_at",
    "result",
    "provenance"
  ],
  "title": "QualityAssessment",
  "type": "object"
}
