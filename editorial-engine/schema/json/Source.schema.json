{
  "$defs": {
    "SourceReliability": {
      "description": "Distinct from EvidenceCertainty: this rates the SOURCE, not a claim.",
      "enum": [
        "verified",
        "strongly_supported",
        "reported",
        "unverified"
      ],
      "title": "SourceReliability",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "book",
        "story_bible",
        "research",
        "experience",
        "review",
        "comment",
        "photograph",
        "interview",
        "model",
        "website",
        "previous_content"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "UsageRights": {
      "enum": [
        "owned",
        "licensed",
        "fair_use_claimed",
        "permission_granted",
        "restricted",
        "unclear"
      ],
      "title": "UsageRights",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "origin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where/how this source was obtained.",
      "title": "Origin"
    },
    "content_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pointer to the actual material -- file path, URL, or archive id. Not the material itself.",
      "title": "Content Reference"
    },
    "themes": {
      "items": {
        "type": "string"
      },
      "title": "Themes",
      "type": "array"
    },
    "people": {
      "items": {
        "type": "string"
      },
      "title": "People",
      "type": "array"
    },
    "models": {
      "items": {
        "type": "string"
      },
      "title": "Models",
      "type": "array"
    },
    "series": {
      "description": "Series.series_id values this source relates to.",
      "items": {
        "type": "string"
      },
      "title": "Series",
      "type": "array"
    },
    "reliability": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceReliability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "usage_rights": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageRights"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "source_id",
    "source_type",
    "title"
  ],
  "title": "Source",
  "type": "object"
}
