{
  "$defs": {
    "Actor": {
      "description": "Who or what produced a piece of data.",
      "enum": [
        "human",
        "ai_system",
        "import"
      ],
      "title": "Actor",
      "type": "string"
    },
    "EditorialPotential": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "EditorialPotential",
      "type": "string"
    },
    "EvidenceCertainty": {
      "description": "How solid is a given piece of editorial data.\n\nMirrors Beslut 23's required three-way split, plus an explicit\n\"unconfirmed\" state so that uncertainty is a first-class value rather\nthan an absent field or a disguised default.",
      "enum": [
        "verified",
        "strongly_supported",
        "analytical_proposal",
        "unconfirmed"
      ],
      "title": "EvidenceCertainty",
      "type": "string"
    },
    "IdeaInterpretation": {
      "additionalProperties": false,
      "description": "The system's reading of a raw input. Always secondary to, and never a\nsubstitute for, RawInput.text. Re-analysis creates a NEW\nIdeaInterpretation-bearing Idea revision rather than overwriting this\nobject in place -- see docs/VERSIONING_STRATEGY.md.",
      "properties": {
        "observed_situation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Situation"
        },
        "human_subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who this idea is fundamentally about.",
          "title": "Human Subject"
        },
        "human_experience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Experience"
        },
        "visible_problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visible Problem"
        },
        "hidden_conflict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hidden Conflict"
        },
        "possible_root_causes": {
          "items": {
            "type": "string"
          },
          "title": "Possible Root Causes",
          "type": "array"
        },
        "power_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power Dimension"
        },
        "relationship_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Dimension"
        },
        "system_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System Dimension"
        },
        "possible_consequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Possible Consequence"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "description": "Who/what produced this interpretation, when, and under which analysis_logic_version."
        }
      },
      "required": [
        "provenance"
      ],
      "title": "IdeaInterpretation",
      "type": "object"
    },
    "IdeaStatus": {
      "description": "Own lifecycle -- see docs/ARCHITECTURE_NOTE.md Beslut 19 rationale.",
      "enum": [
        "raw",
        "analyzed",
        "candidate",
        "angled",
        "on_hold",
        "archived"
      ],
      "title": "IdeaStatus",
      "type": "string"
    },
    "InputType": {
      "description": "Shape of the raw material an Idea originated from.",
      "enum": [
        "observation",
        "overheard",
        "quote",
        "question",
        "pattern_note",
        "research_snippet",
        "personal_experience",
        "reader_reaction",
        "other"
      ],
      "title": "InputType",
      "type": "string"
    },
    "NoveltyRisk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "NoveltyRisk",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "actor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free identifier for the actor, e.g. a human's name/initials or an AI system+model name. None only if genuinely unrecorded.",
          "title": "Actor Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "certainty": {
          "$ref": "#/$defs/EvidenceCertainty"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the value was produced, e.g. 'manual_entry', 'fas_0a_analysis', 'fas_0b_analysis', 'ai_inference'.",
          "title": "Method"
        },
        "analysis_logic_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version identifier of whatever analysis logic produced an interpretation, distinct from schema_version. Required whenever created_by == AI_SYSTEM (see tests/test_relation_integrity.py).",
          "title": "Analysis Logic Version"
        },
        "supporting_source_ids": {
          "description": "SOURCE.source_id values that back this claim, if any. Empty list, not a guess, when nothing supports it yet.",
          "items": {
            "type": "string"
          },
          "title": "Supporting Source Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "created_by",
        "created_at",
        "certainty"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "idea_id": {
      "title": "Idea Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "raw_input_id": {
      "description": "FK -> RawInput.raw_input_id. Never an inline copy of the text.",
      "title": "Raw Input Id",
      "type": "string"
    },
    "input_type": {
      "$ref": "#/$defs/InputType"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FK -> Source.source_id, if this idea originated from a tracked source.",
      "title": "Source Id"
    },
    "language": {
      "description": "ISO 639-1 code of the raw input, e.g. 'sv'.",
      "title": "Language",
      "type": "string"
    },
    "intended_market": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Free market code, e.g. 'SE', 'US'. None if not yet decided.",
      "title": "Intended Market"
    },
    "interpretation": {
      "anyOf": [
        {
          "$ref": "#/$defs/IdeaInterpretation"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None until the first analysis pass has run; presence of this object is what IdeaStatus.ANALYZED means."
    },
    "related_series": {
      "description": "Series.series_id values.",
      "items": {
        "type": "string"
      },
      "title": "Related Series",
      "type": "array"
    },
    "related_thesis_families": {
      "description": "ThesisFamily.thesis_family_id values.",
      "items": {
        "type": "string"
      },
      "title": "Related Thesis Families",
      "type": "array"
    },
    "related_models": {
      "description": "Free identifiers for photo/story models involved.",
      "items": {
        "type": "string"
      },
      "title": "Related Models",
      "type": "array"
    },
    "related_characters": {
      "items": {
        "type": "string"
      },
      "title": "Related Characters",
      "type": "array"
    },
    "related_books": {
      "items": {
        "type": "string"
      },
      "title": "Related Books",
      "type": "array"
    },
    "related_previous_content": {
      "description": "ContentRecord.content_id values.",
      "items": {
        "type": "string"
      },
      "title": "Related Previous Content",
      "type": "array"
    },
    "editorial_potential": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditorialPotential"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "novelty_risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoveltyRisk"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/IdeaStatus",
      "default": "raw"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "idea_id",
    "created_at",
    "raw_input_id",
    "input_type",
    "language"
  ],
  "title": "Idea",
  "type": "object"
}
