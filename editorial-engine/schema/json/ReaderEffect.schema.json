{
  "$defs": {
    "Actor": {
      "description": "Who or what produced a piece of data.",
      "enum": [
        "human",
        "ai_system",
        "import"
      ],
      "title": "Actor",
      "type": "string"
    },
    "EvidenceCertainty": {
      "description": "How solid is a given piece of editorial data.\n\nMirrors Beslut 23's required three-way split, plus an explicit\n\"unconfirmed\" state so that uncertainty is a first-class value rather\nthan an absent field or a disguised default.",
      "enum": [
        "verified",
        "strongly_supported",
        "analytical_proposal",
        "unconfirmed"
      ],
      "title": "EvidenceCertainty",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "actor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free identifier for the actor, e.g. a human's name/initials or an AI system+model name. None only if genuinely unrecorded.",
          "title": "Actor Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "certainty": {
          "$ref": "#/$defs/EvidenceCertainty"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the value was produced, e.g. 'manual_entry', 'fas_0a_analysis', 'fas_0b_analysis', 'ai_inference'.",
          "title": "Method"
        },
        "analysis_logic_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version identifier of whatever analysis logic produced an interpretation, distinct from schema_version. Required whenever created_by == AI_SYSTEM (see tests/test_relation_integrity.py).",
          "title": "Analysis Logic Version"
        },
        "supporting_source_ids": {
          "description": "SOURCE.source_id values that back this claim, if any. Empty list, not a guess, when nothing supports it yet.",
          "items": {
            "type": "string"
          },
          "title": "Supporting Source Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "created_by",
        "created_at",
        "certainty"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReaderEffectCategory": {
      "description": "Beslut 15.",
      "enum": [
        "immediate",
        "cognitive",
        "emotional",
        "aftereffect"
      ],
      "title": "ReaderEffectCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A taxonomy entry, e.g. category=EMOTIONAL, name='discomfort'.",
  "properties": {
    "reader_effect_id": {
      "title": "Reader Effect Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/ReaderEffectCategory"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "examples": {
      "items": {
        "type": "string"
      },
      "title": "Examples",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    }
  },
  "required": [
    "reader_effect_id",
    "category",
    "name",
    "created_at",
    "provenance"
  ],
  "title": "ReaderEffect",
  "type": "object"
}
