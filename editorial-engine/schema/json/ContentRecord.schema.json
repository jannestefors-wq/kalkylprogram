{
  "$defs": {
    "Actor": {
      "description": "Who or what produced a piece of data.",
      "enum": [
        "human",
        "ai_system",
        "import"
      ],
      "title": "Actor",
      "type": "string"
    },
    "ContentForm": {
      "additionalProperties": false,
      "description": "The FORM variation dimension (Beslut 10) -- how the text is built.",
      "properties": {
        "form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Open vocabulary format tag, e.g. 'linkedin_post', 'letter'.",
          "title": "Form"
        },
        "narrative_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrativeMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "point_of_view": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointOfView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opening_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Open vocabulary, may reference a StyleAttribute.",
          "title": "Opening Type"
        },
        "opening_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opening Text"
        },
        "dramaturgy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dramaturgy"
        },
        "paragraph_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Pattern"
        },
        "sentence_rhythm": {
          "anyOf": [
            {
              "$ref": "#/$defs/RhythmPattern"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "length_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/LengthClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "emotional_register": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmotionalRegister"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "personal_presence": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "solution_degree": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Count"
        },
        "contrast_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metaphor_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dialogue_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scene_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ending_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndingType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cta_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/CtaType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature Type"
        },
        "key_phrases": {
          "items": {
            "type": "string"
          },
          "title": "Key Phrases",
          "type": "array"
        },
        "rhetorical_patterns": {
          "items": {
            "type": "string"
          },
          "title": "Rhetorical Patterns",
          "type": "array"
        }
      },
      "title": "ContentForm",
      "type": "object"
    },
    "ContentStatus": {
      "description": "Own lifecycle, deliberately close to the shared vocabulary listed in\nBeslut 19, because CONTENT RECORD is the one object that genuinely\npasses through all of these stages in roughly this order.",
      "enum": [
        "draft",
        "quality_review",
        "rework",
        "reangle",
        "hold",
        "human_approved",
        "published",
        "archived"
      ],
      "title": "ContentStatus",
      "type": "string"
    },
    "ContentWhat": {
      "additionalProperties": false,
      "description": "The CONTENT + PERSPECTIVE variation dimensions (Beslut 10).",
      "properties": {
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Open vocabulary tag, e.g. 'Tillit'. Never a series_id.",
          "title": "Topic"
        },
        "subtopics": {
          "items": {
            "type": "string"
          },
          "title": "Subtopics",
          "type": "array"
        },
        "core_thesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Core Thesis"
        },
        "human_conflict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Conflict"
        },
        "hidden_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hidden Pattern"
        },
        "root_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Cause"
        },
        "perspective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whose reality this text is told from.",
          "title": "Perspective"
        }
      },
      "title": "ContentWhat",
      "type": "object"
    },
    "CtaType": {
      "enum": [
        "none",
        "implicit_reflection",
        "explicit_question",
        "explicit_action",
        "other"
      ],
      "title": "CtaType",
      "type": "string"
    },
    "DegreeLevel": {
      "description": "Generic low/medium/high scale used where Fas 0 material speaks in degrees,\nnot numbers (e.g. personal_presence, solution_degree, contrast_usage).",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "DegreeLevel",
      "type": "string"
    },
    "EmotionalRegister": {
      "enum": [
        "discomfort",
        "recognition",
        "stillness",
        "dignity",
        "relief",
        "urgency",
        "other"
      ],
      "title": "EmotionalRegister",
      "type": "string"
    },
    "EndingType": {
      "enum": [
        "unresolved_scene",
        "resolved_scene",
        "open_question",
        "directive",
        "reflection",
        "other"
      ],
      "title": "EndingType",
      "type": "string"
    },
    "EvidenceCertainty": {
      "description": "How solid is a given piece of editorial data.\n\nMirrors Beslut 23's required three-way split, plus an explicit\n\"unconfirmed\" state so that uncertainty is a first-class value rather\nthan an absent field or a disguised default.",
      "enum": [
        "verified",
        "strongly_supported",
        "analytical_proposal",
        "unconfirmed"
      ],
      "title": "EvidenceCertainty",
      "type": "string"
    },
    "LengthClass": {
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "title": "LengthClass",
      "type": "string"
    },
    "NarrativeMode": {
      "enum": [
        "scene",
        "argument",
        "analysis",
        "letter",
        "list",
        "dialogue",
        "other"
      ],
      "title": "NarrativeMode",
      "type": "string"
    },
    "PointOfView": {
      "enum": [
        "first_person",
        "observer",
        "second_person",
        "collective",
        "other"
      ],
      "title": "PointOfView",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "actor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free identifier for the actor, e.g. a human's name/initials or an AI system+model name. None only if genuinely unrecorded.",
          "title": "Actor Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "certainty": {
          "$ref": "#/$defs/EvidenceCertainty"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the value was produced, e.g. 'manual_entry', 'fas_0a_analysis', 'fas_0b_analysis', 'ai_inference'.",
          "title": "Method"
        },
        "analysis_logic_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version identifier of whatever analysis logic produced an interpretation, distinct from schema_version. Required whenever created_by == AI_SYSTEM (see tests/test_relation_integrity.py).",
          "title": "Analysis Logic Version"
        },
        "supporting_source_ids": {
          "description": "SOURCE.source_id values that back this claim, if any. Empty list, not a guess, when nothing supports it yet.",
          "items": {
            "type": "string"
          },
          "title": "Supporting Source Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "created_by",
        "created_at",
        "certainty"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReaderEffectAssociation": {
      "additionalProperties": false,
      "description": "Embedded in ContentRecord. One row = one claimed effect, one mode.",
      "properties": {
        "reader_effect_id": {
          "description": "FK -> ReaderEffect.reader_effect_id.",
          "title": "Reader Effect Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/ReaderEffectMode"
        },
        "evidence_reader_feedback_ids": {
          "description": "ReaderFeedback.reader_feedback_id values supporting an OBSERVED claim. Always empty for INTENDED associations.",
          "items": {
            "type": "string"
          },
          "title": "Evidence Reader Feedback Ids",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "reader_effect_id",
        "mode"
      ],
      "title": "ReaderEffectAssociation",
      "type": "object"
    },
    "ReaderEffectMode": {
      "description": "Beslut 15: intended vs. observed must stay distinguishable.",
      "enum": [
        "intended",
        "observed"
      ],
      "title": "ReaderEffectMode",
      "type": "string"
    },
    "RhythmPattern": {
      "enum": [
        "uniform",
        "mixed",
        "staccato",
        "flowing"
      ],
      "title": "RhythmPattern",
      "type": "string"
    },
    "VariationFingerprint": {
      "additionalProperties": false,
      "description": "Compact per-text fingerprint (Beslut 9). Deliberately just a labelled\nsnapshot of ContentForm -- no comparison logic. A future component can\ndiff `VariationFingerprint` instances across the last N publications;\nthis schema only fixes what the labels are and how they are spelled.",
      "properties": {
        "content_id": {
          "description": "FK -> ContentRecord.content_id this fingerprint was taken from.",
          "title": "Content Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "form": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrativeMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opening": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opening"
        },
        "pov": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointOfView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "length": {
          "anyOf": [
            {
              "$ref": "#/$defs/LengthClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rhythm": {
          "anyOf": [
            {
              "$ref": "#/$defs/RhythmPattern"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "emotion": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmotionalRegister"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "personal": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contrast": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "solution": {
          "anyOf": [
            {
              "$ref": "#/$defs/DegreeLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ending": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndingType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cta": {
          "anyOf": [
            {
              "$ref": "#/$defs/CtaType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "content_id",
        "computed_at"
      ],
      "title": "VariationFingerprint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_id": {
      "title": "Content Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "language": {
      "description": "ISO 639-1 code.",
      "title": "Language",
      "type": "string"
    },
    "market": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market"
    },
    "platform": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform"
    },
    "status": {
      "$ref": "#/$defs/ContentStatus",
      "default": "draft"
    },
    "idea_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "TECHNICAL PROPOSAL field -- FK -> Idea.idea_id.",
      "title": "Idea Id"
    },
    "angle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "TECHNICAL PROPOSAL field -- FK -> Angle.angle_id.",
      "title": "Angle Id"
    },
    "voice_core_version_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "TECHNICAL PROPOSAL field -- label like 'voice-core-1.0' this text was authored/judged against.",
      "title": "Voice Core Version Ref"
    },
    "series_ids": {
      "description": "Series.series_id values.",
      "items": {
        "type": "string"
      },
      "title": "Series Ids",
      "type": "array"
    },
    "thesis_family_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thesis Family Id"
    },
    "what": {
      "$ref": "#/$defs/ContentWhat"
    },
    "form_detail": {
      "$ref": "#/$defs/ContentForm"
    },
    "reader_effects": {
      "items": {
        "$ref": "#/$defs/ReaderEffectAssociation"
      },
      "title": "Reader Effects",
      "type": "array"
    },
    "variation_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariationFingerprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "style_attributes_used": {
      "description": "StyleAttribute.style_attribute_id values.",
      "items": {
        "type": "string"
      },
      "title": "Style Attributes Used",
      "type": "array"
    },
    "repetition_signals_observed": {
      "description": "RepetitionSignal.repetition_signal_id values noted present in this text. Observation storage only -- no measurement is computed here.",
      "items": {
        "type": "string"
      },
      "title": "Repetition Signals Observed",
      "type": "array"
    },
    "related_content_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Content Ids",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "final_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None until the text is finalized.",
      "title": "Final Text"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "content_id",
    "created_at",
    "language",
    "provenance"
  ],
  "title": "ContentRecord",
  "type": "object"
}
