{
  "$defs": {
    "FeedbackVerificationStatus": {
      "description": "Beslut 16: a reader reaction is evidence, not automatically canonical.",
      "enum": [
        "verified_verbatim",
        "paraphrased",
        "unverified"
      ],
      "title": "FeedbackVerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reader_feedback_id": {
      "title": "Reader Feedback Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FK -> Source.source_id, if the feedback is filed as a Source.",
      "title": "Source Id"
    },
    "content_reference": {
      "description": "FK -> ContentRecord.content_id this feedback responds to.",
      "title": "Content Reference",
      "type": "string"
    },
    "feedback_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Verbatim or excerpted feedback text.",
      "title": "Feedback Text"
    },
    "feedback_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pointer to the full feedback elsewhere (e.g. a document), when not inlined.",
      "title": "Feedback Reference"
    },
    "effect_observations": {
      "description": "Free-text notes on what effect this feedback seems to evidence, prior to being formalized into a ReaderEffectAssociation.",
      "items": {
        "type": "string"
      },
      "title": "Effect Observations",
      "type": "array"
    },
    "verification_status": {
      "$ref": "#/$defs/FeedbackVerificationStatus"
    },
    "date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "reader_feedback_id",
    "content_reference",
    "verification_status"
  ],
  "title": "ReaderFeedback",
  "type": "object"
}
