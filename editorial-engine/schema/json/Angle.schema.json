{
  "$defs": {
    "Actor": {
      "description": "Who or what produced a piece of data.",
      "enum": [
        "human",
        "ai_system",
        "import"
      ],
      "title": "Actor",
      "type": "string"
    },
    "AngleStatus": {
      "enum": [
        "proposed",
        "selected",
        "rejected",
        "superseded"
      ],
      "title": "AngleStatus",
      "type": "string"
    },
    "EvidenceCertainty": {
      "description": "How solid is a given piece of editorial data.\n\nMirrors Beslut 23's required three-way split, plus an explicit\n\"unconfirmed\" state so that uncertainty is a first-class value rather\nthan an absent field or a disguised default.",
      "enum": [
        "verified",
        "strongly_supported",
        "analytical_proposal",
        "unconfirmed"
      ],
      "title": "EvidenceCertainty",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "actor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free identifier for the actor, e.g. a human's name/initials or an AI system+model name. None only if genuinely unrecorded.",
          "title": "Actor Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "certainty": {
          "$ref": "#/$defs/EvidenceCertainty"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the value was produced, e.g. 'manual_entry', 'fas_0a_analysis', 'fas_0b_analysis', 'ai_inference'.",
          "title": "Method"
        },
        "analysis_logic_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version identifier of whatever analysis logic produced an interpretation, distinct from schema_version. REQUIRED (validated below) whenever created_by == Actor.AI_SYSTEM. May be null for human-created provenance.",
          "title": "Analysis Logic Version"
        },
        "supporting_source_ids": {
          "description": "SOURCE.source_id values that back this claim, if any. Empty list, not a guess, when nothing supports it yet.",
          "items": {
            "type": "string"
          },
          "title": "Supporting Source Ids",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "created_by",
        "created_at",
        "certainty"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "VariationDimension": {
      "description": "Beslut 10: the four axes that must never be collapsed into one.",
      "enum": [
        "content",
        "perspective",
        "form",
        "effect"
      ],
      "title": "VariationDimension",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "angle_id": {
      "title": "Angle Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "idea_id": {
      "description": "FK -> Idea.idea_id.",
      "title": "Idea Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "thesis_family_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FK -> ThesisFamily.thesis_family_id.",
      "title": "Thesis Family Id"
    },
    "primary_variation_dimension": {
      "anyOf": [
        {
          "$ref": "#/$defs/VariationDimension"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Which of the four Beslut-10 dimensions this angle most distinctly varies relative to prior treatments of the same idea/thesis family."
    },
    "status": {
      "$ref": "#/$defs/AngleStatus",
      "default": "proposed"
    },
    "rejected_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Reason"
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "angle_id of the angle that replaced this one.",
      "title": "Superseded By"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "angle_id",
    "idea_id",
    "created_at",
    "title",
    "description",
    "provenance"
  ],
  "title": "Angle",
  "type": "object"
}
