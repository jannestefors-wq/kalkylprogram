{
  "$defs": {
    "Actor": {
      "description": "Who or what produced a piece of data.",
      "enum": [
        "human",
        "ai_system",
        "import"
      ],
      "title": "Actor",
      "type": "string"
    },
    "DecisionTargetType": {
      "description": "What kind of canonical object a HumanDecision or QualityAssessment\ncan be attached to.",
      "enum": [
        "idea",
        "angle",
        "content_record",
        "quality_assessment"
      ],
      "title": "DecisionTargetType",
      "type": "string"
    },
    "HumanDecisionType": {
      "enum": [
        "approve",
        "reject",
        "rework",
        "reangle",
        "hold",
        "publish",
        "archive"
      ],
      "title": "HumanDecisionType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_type": {
      "$ref": "#/$defs/DecisionTargetType"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/HumanDecisionType"
    },
    "decided_by": {
      "description": "Name/id of the human who made this decision. Never 'AI' or a system id.",
      "title": "Decided By",
      "type": "string"
    },
    "decided_by_actor": {
      "$ref": "#/$defs/Actor",
      "default": "human",
      "description": "Always Actor.HUMAN for a valid HumanDecision -- kept explicit so the invariant is checkable on the object itself, not only by convention."
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "based_on_quality_assessment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FK -> QualityAssessment.quality_assessment_id, if this decision followed one. The AI assessment is input; this field never substitutes for decided_by.",
      "title": "Based On Quality Assessment Id"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "decision_id",
    "target_type",
    "target_id",
    "decision",
    "decided_by",
    "decided_at"
  ],
  "title": "HumanDecision",
  "type": "object"
}
